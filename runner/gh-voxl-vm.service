[Unit]
Description=On-demand isolated GitHub Actions VM for Voxl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gh-voxl-vm
Group=gh-voxl-vm
SupplementaryGroups=kvm
RuntimeDirectory=gh-voxl-vm
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/local/libexec/gh-voxl-vm-firewall
ExecStart=/usr/bin/qemu-system-x86_64 -name gh-voxl-runner -machine q35,accel=kvm -cpu host -smp 12 -m 8192 -nodefaults -drive file=/var/lib/gh-voxl-vm/disk.qcow2,if=virtio,format=qcow2,cache=writeback,discard=unmap -drive file=/var/lib/gh-voxl-vm/seed.iso,media=cdrom,readonly=on -netdev user,id=net0,hostfwd=tcp:127.0.0.1:2227-:22 -device virtio-net-pci,netdev=net0 -device virtio-rng-pci -display none -serial file:/var/lib/gh-voxl-vm/serial.log -qmp unix:/run/gh-voxl-vm/qmp.sock,server=on,wait=off
ExecStop=/usr/bin/python3 /usr/local/libexec/gh-voxl-vm-poweroff.py
TimeoutStopSec=90
Restart=no
KillMode=mixed
Nice=10
CPUWeight=50
CPUQuota=1200%
MemoryMax=10G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/gh-voxl-vm /run/gh-voxl-vm
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
